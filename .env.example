# ===== AIバックエンドの選択 =====
# claude-code: Claude Code のログイン（Pro/Max サブスクの利用枠）で動かす【推奨】
#              → Claude Code をインストールして `claude` でログインしておけば設定不要
# api:         Anthropic API キーで動かす（従量課金）
# mock:        APIなしの動作確認用サンプル応答
#
# 未指定の場合: MOCK_AI=1 なら mock、ANTHROPIC_API_KEY があれば api、
#               どちらもなければ claude-code（サブスク）になります。
# AI_BACKEND=claude-code

# ===== claude-code バックエンド（サブスク利用）の設定 =====
# 使用モデル別名: opus / sonnet / haiku（省略時: opus）
# 利用上限に当たりやすい場合は sonnet がおすすめ
# CLAUDE_CODE_MODEL=opus

# ===== api バックエンド（従量課金）の設定 =====
# ※ サブスクで使いたい場合はここを設定しないこと！
#    ANTHROPIC_API_KEY が設定されていると API 従量課金が優先されます。
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5

# ===== 動作確認モード =====
# MOCK_AI=1

# ===== Bambu Lab P2S 連携（任意） =====
# LANモード + 開発者モードを有効にした上で設定
# BAMBU_IP=192.168.1.xx
# BAMBU_ACCESS_CODE=12345678
# BAMBU_SERIAL=01S00A000000000
# AMS(自動フィラメント供給)を使わない場合は 0
# BAMBU_USE_AMS=1

# ===== ワンタップ印刷（任意） =====
# スライサーCLIのコマンドテンプレート。{input}=STL, {output}=出力3MF に置換される。
# 設定すると、アプリの「🖨 P2Sで印刷開始」ボタンで スライス→送信→印刷開始 まで自動実行。
# プロファイル(machine/process/filament)は Bambu Studio / OrcaSlicer からエクスポートしておく。
# 例:
# SLICER_CMD=orca-slicer --load-settings "profiles/machine.json;profiles/process.json" --load-filaments profiles/filament.json --slice 0 --export-3mf {output} {input}
