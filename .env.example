# ===== 必須 =====
# Anthropic API キー (https://console.anthropic.com/ で取得)
ANTHROPIC_API_KEY=sk-ant-...

# ===== 任意 =====
# 使用モデル（省略時: claude-opus-5）
# ANTHROPIC_MODEL=claude-opus-5

# APIキーなしで動作確認したいとき 1 にする（AIの代わりにサンプル応答を返す）
# MOCK_AI=1

# Bambu Lab P2S 連携（LANモード + 開発者モードを有効にした上で設定）
# BAMBU_IP=192.168.1.xx
# BAMBU_ACCESS_CODE=12345678
# BAMBU_SERIAL=01S00A000000000
